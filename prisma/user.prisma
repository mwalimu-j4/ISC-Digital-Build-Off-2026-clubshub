model User {
  id                     String          @id @default(uuid()) @db.Uuid
  fullName               String          @map("full_name") @db.VarChar(160)
  email                  String          @unique @db.VarChar(320)
  studentRegistrationId  String          @unique @map("student_registration_id") @db.VarChar(80)
  role                   UserRole        @default(STUDENT)
  status                 UserStatus      @default(ACTIVE)
  avatarUrl              String?         @map("avatar_url") @db.VarChar(2048)
  bio                    String?         @db.VarChar(500)
  course                 String?         @db.VarChar(100)
  yearOfStudy            String?         @map("year_of_study") @db.VarChar(20)
  createdAt              DateTime        @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt              DateTime        @updatedAt @db.Timestamptz(3) @map("updated_at")
  createdClubs            Club[]          @relation("ClubCreator")
  reviewedClubs           Club[]          @relation("ClubReviewer")
  suspendedClubs          Club[]          @relation("ClubSuspender")
  memberships             ClubMembership[]
  auditLogs               AuditLog[]      @relation("AuditActor")

  // Lost & Found relations
  lostFoundReports        LostFoundItem[]          @relation("LostFoundReporter")
  statusHistoryActions    LostFoundStatusHistory[] @relation("StatusHistoryActor")
  assignedRecoveryTasks   RecoveryTask[]           @relation("RecoveryOfficer")
  searchedCheckpoints     RecoveryCheckpoint[]     @relation("CheckpointSearcher")
  reviewedMatches         LostFoundMatch[]         @relation("MatchReviewer")
  claimsSubmitted         LostFoundClaim[]         @relation("ClaimClaimant")
  claimsVerified          LostFoundClaim[]         @relation("ClaimVerifier")
  claimsHandedOver        LostFoundClaim[]         @relation("ClaimHandoverOfficer")
  notifications           Notification[]           @relation("NotificationRecipient")

  @@index([status])
  @@index([role])
  @@map("users")
}
