model User {
  id                     String          @id @default(uuid()) @db.Uuid
  fullName               String          @map("full_name") @db.VarChar(160)
  email                  String          @unique @db.VarChar(320)
  studentRegistrationId  String          @unique @map("student_registration_id") @db.VarChar(80)
  role                   UserRole        @default(STUDENT)
  status                 UserStatus      @default(ACTIVE)
  createdAt              DateTime        @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt              DateTime        @updatedAt @db.Timestamptz(3) @map("updated_at")
  createdClubs            Club[]          @relation("ClubCreator")
  reviewedClubs           Club[]          @relation("ClubReviewer")
  suspendedClubs          Club[]          @relation("ClubSuspender")
  memberships             ClubMembership[]
  auditLogs               AuditLog[]      @relation("AuditActor")

  @@index([status])
  @@index([role])
  @@map("users")
}
