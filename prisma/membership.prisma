model ClubMembership {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  clubId     String           @map("club_id") @db.Uuid
  role       MembershipRole   @default(MEMBER)
  officialRole String?        @map("official_role") @db.VarChar(80)
  status     MembershipStatus @default(PENDING)
  appliedAt  DateTime         @default(now()) @db.Timestamptz(3) @map("applied_at")
  approvedAt DateTime?        @db.Timestamptz(3) @map("approved_at")
  schoolId   String?          @map("school_id") @db.VarChar(80)
  department String?          @db.VarChar(120)
  major      String?          @db.VarChar(80)
  message    String?          @db.VarChar(280)
  yearOfStudy String?         @map("year_of_study") @db.VarChar(20)
  decidedById String?         @map("decided_by_id") @db.Uuid
  decidedAt  DateTime?        @map("decided_at") @db.Timestamptz(3)
  decisionNote String?        @map("decision_note") @db.VarChar(200)
  decisionReason String?      @map("decision_reason") @db.VarChar(120)
  undoUntil  DateTime?        @map("undo_until") @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(3) @map("updated_at")
  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  club       Club             @relation(fields: [clubId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  decidedBy  User?            @relation("MembershipDecisions", fields: [decidedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([userId, clubId])
  @@index([clubId, status])
  @@index([userId, status])
  @@index([clubId, status, appliedAt])
  @@map("club_memberships")
}
