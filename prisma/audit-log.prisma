model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String   @db.VarChar(120)
  targetEntity   String   @map("target_entity") @db.VarChar(80)
  targetEntityId String   @map("target_entity_id") @db.Uuid
  metadata       Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  actor          User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([actorId, createdAt])
  @@index([targetEntity, targetEntityId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}
